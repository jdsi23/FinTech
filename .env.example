# Copy this file to .env.local and fill in the values from your Firebase
# project settings (Firebase Console -> Project settings -> General ->
# "Your apps" -> Web app -> SDK setup and configuration -> Config).
#
# .env.local is gitignored and must never be committed. These values are
# not secret in the traditional sense (they end up in the public JS bundle),
# but Firestore Security Rules -- not these keys -- are what actually
# protect user data. See README.md for the full setup walkthrough.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
